{
  "name": "tiktok-training-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site-data.mjs",
    "collect:tiktok": "node scripts/collect-tiktok.mjs",
    "make:gifs": "node scripts/make-gifs.mjs",
    "make:webp": "node scripts/make-webp.mjs",
    "make:pwa-icons": "node scripts/make-pwa-icons.mjs",
    "serve": "node scripts/serve-docs.mjs",
    "analyze:exercises": "node scripts/analyze-exercise-videos.mjs",
    "extract:samples": "node scripts/extract-sample-clips.mjs",
    "extract:all": "node scripts/extract-all-exercises.mjs",
    "categorize:exercises": "node scripts/categorize-exercises.mjs",
    "smart:categorize": "node scripts/smart-categorize-exercises.mjs",
    "check": "node --check scripts/collect-tiktok.mjs && node --check scripts/make-gifs.mjs && node --check scripts/make-webp.mjs && node --check scripts/build-site-data.mjs && node --check scripts/make-pwa-icons.mjs && node --check scripts/serve-docs.mjs && node --check docs/sw.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.53.0"
  }
}
